# Meraki Dashboard API Configuration
# Get your API key from: https://dashboard.meraki.com/api_keys

# Your Meraki Dashboard API Key (required)
MERAKI_API_KEY=your_api_key_here

# Meraki API Base URL (default: https://api.meraki.com/api/v1)
MERAKI_BASE_URL=https://api.meraki.com/api/v1

# Rate limiting (requests per second per organization, default: 5)
MERAKI_RATE_LIMIT=5

# Request timeout in milliseconds (default: 30000)
MERAKI_TIMEOUT=30000

# Enable debug logging (default: false)
DEBUG=false
